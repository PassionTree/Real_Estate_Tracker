// 부동산 트래커 — 데이터 모델
//
// 금액은 전부 "만원 단위 정수"로 저장한다.
// 원 단위 실수를 쓰면 5억 8천만원이 579999999.9999 가 되는 일이 생긴다.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// 관심 매물. 필수 입력은 nickname 하나뿐이고 나머지는 전부 나중에 채운다.
/// 등록 마찰을 줄이는 것이 이 앱의 성패를 가르므로, 스키마 차원에서 부분 입력을 기본값으로 둔다.
model Listing {
  id       String @id @default(cuid())
  nickname String

  // 빠른 등록에서 함께 받는 두 가지
  priceManwon Int?
  sourceUrl   String?

  dealType     String @default("매매") // 매매 | 전세 | 월세
  propertyType String @default("아파트") // 아파트 | 오피스텔 | 빌라 | 단독
  status       String @default("관심") // 관심 | 임장예정 | 임장완료 | 보류 | 제외 | 계약

  address     String?
  lawdCd      String? // 법정동 앞 5자리. Phase 2 실거래가 매칭 키
  complexName String?
  dong        String?
  ho          String?

  areaM2       Float? // 전용면적
  supplyAreaM2 Float? // 공급면적
  floor        Int?
  totalFloors  Int?
  builtYear    Int?
  householdCount Int?

  depositManwon     Int? // 전세보증금 / 월세보증금
  monthlyRentManwon Int?
  maintenanceManwon Int? // 관리비

  rooms       Int?
  bathrooms   Int?
  direction   String?
  parking     String?
  petsAllowed Boolean?

  /// 단일 통근시간(분). 다중 목적지는 Phase 2.
  /// 정렬·필터에 바로 쓰이고 비용이 0이라 1차에 넣는다.
  commuteMinutes Int?

  lat Float? // Phase 2 지도
  lng Float?

  tags String  @default("") // SQLite에 배열이 없어 콤마 구분으로 저장
  memo String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceHistory PriceHistory[]
  scores       ListingScore[]

  @@index([status])
  @@index([lawdCd])
  @@index([createdAt])
}

/// 호가 변동 이력.
/// 다른 기능과 달리 소급이 불가능하다 — 나중에 붙이면 그 전 변동은 영원히 사라진다.
/// 그래서 1차에 반드시 들어간다.
model PriceHistory {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  priceManwon       Int?
  depositManwon     Int?
  monthlyRentManwon Int?

  note       String? // "중개사 전화: 5천 조정 가능"
  recordedBy String?
  recordedAt DateTime @default(now())

  @@index([listingId, recordedAt])
}

/// 평가 항목 정의. 기본 6개로 시작한다 — 항목이 많으면 아무도 채우지 않는다.
model Criterion {
  id            String  @id @default(cuid())
  name          String  @unique
  weight        Int     @default(3) // 1~5 중요도
  isDealBreaker Boolean @default(false)
  sortOrder     Int     @default(0)

  scores ListingScore[]
}

model ListingScore {
  id          String @id @default(cuid())
  listingId   String
  criterionId String

  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  criterion Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  value    Int // 1~5
  scoredBy String?

  @@unique([listingId, criterionId])
}

model Setting {
  key   String @id
  value String
}

/// 국토부 실거래가 캐시.
///
/// "조건에 맞는 단지 찾기"의 원재료다. 화면을 열 때마다 API 를 부르지 않고
/// 여기 쌓인 걸 조회한다. 원본 응답을 그대로 담되 조회에 실제로 쓸 값만 정규화한다.
model Transaction {
  id String @id @default(cuid())

  aptSeq String? // 단지 식별자(있으면 매칭 키로 쓴다). 안정성은 실제 응답으로 확인 필요
  aptNm  String
  lawdCd String // 법정동 앞 5자리 — 수집·조회 키
  umdNm  String?
  jibun  String?
  roadNm String?

  buildYear  Int?
  excluUseAr Float // 전용면적(㎡)
  /// 평형 그룹핑용 반올림값. 84.96 / 84.9562 가 같은 그룹이 되게 한다
  areaGroup Int
  floor     Int?

  dealAmountManwon Int
  dealDate         DateTime
  dealYmd          String // "202608" — 수집 단위, 재수집 판단에 쓴다

  /// 계약이 해제된 거래인지. true 면 시세 집계에서 제외한다.
  /// 해제된 거래를 그대로 두면 튄 값 하나가 중앙값을 흔든다.
  canceled Boolean @default(false)

  fetchedAt DateTime @default(now())

  @@index([lawdCd, dealYmd])
  @@index([aptSeq, areaGroup])
  @@index([buildYear])
}

/// 어느 지역·년월을 언제 수집했는지. 재수집 여부 판단과 진행률 표시에 쓴다.
model RegionSync {
  id       String   @id @default(cuid())
  lawdCd   String
  dealYmd  String
  rowCount Int
  syncedAt DateTime @default(now())

  @@unique([lawdCd, dealYmd])
}
