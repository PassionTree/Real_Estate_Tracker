# ── 필수 ────────────────────────────────────────────────
# 부부·가족이 공유하는 로그인 비밀번호
SHARED_PASSWORD=

# 세션 쿠키 서명키. 아래로 만들어 붙이세요:
#   openssl rand -hex 32
SESSION_SECRET=

# 로그인할 때 고를 이름 목록. 메모·별점의 작성자를 남기는 데만 쓰입니다.
USERS=남편,아내

DATABASE_URL="file:./dev.db"

# ── 선택 (없어도 앱 전체가 정상 동작합니다) ──────────────
# Phase 2. 공공데이터포털 국토교통부 실거래가 API 키
# https://www.data.go.kr/data/15126469/openapi.do
MOLIT_API_KEY=

# Phase 2. 카카오맵 — 지도 뷰와 주소 → 좌표 변환
KAKAO_JS_KEY=
KAKAO_REST_KEY=
